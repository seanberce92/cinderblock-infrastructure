# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfplan
tfplan
qa/terraform.tfvars

# Lambda build artifacts
lambdas/**/lambda.zip

# Installed deps — never committed. Usually test-only devDependencies (see
# lambdas/site-builder/package.json) that never end up in lambda.zip, but for
# lambdas/cognito-email-sender this IS bundled into the zip by build-lambda.sh
# (real runtime dependency, @aws-crypto/client-node) — still shouldn't be
# committed either way; build-lambda.sh reinstalls it fresh on every build.
lambdas/**/node_modules
lambdas/**/package-lock.json

.DS_Store
