<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Site not active</title>
<style>
  :root {
    --primary: #f54900;
    --accent: #f69e03;
    --charcoal: #2d333d;
    --bg: #f4f4f5;
    --border: #e4e4e7;
    --text-muted: #71717a;
    --text-faint: #a1a1aa;
    --text-body: #3f3f46;
    --gradient: linear-gradient(135deg, #f54900 0%, #f69e03 100%);
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: var(--bg);
    color: var(--text-body);
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
  }
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 24px;
  }
  main {
    width: 100%;
    max-width: 440px;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px 36px 36px;
    text-align: center;
    box-shadow: 0 8px 30px -8px rgba(45, 51, 61, 0.12);
  }
  .icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 20px;
  }
  .icon svg { width: 100%; height: 100%; display: block; }
  h1 {
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: 21px;
    font-weight: 600;
    color: var(--charcoal);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 8px;
  }
  .divider {
    height: 1px;
    background: var(--border);
    margin: 28px 0 20px;
    border: none;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gradient);
    display: inline-block;
  }
  footer {
    margin-top: 22px;
    font-size: 12px;
    color: var(--text-faint);
  }
  footer a {
    color: var(--text-faint);
    text-decoration: underline;
  }
</style>
</head>
<body>
<main>
